{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "SwiftpolisKit",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Swiftpolis", "target-membership": [ "Swiftpolis" ] },
    { "kind": "folder", "path": "NativeHost", "target-membership": [ "swiftpolis-native-host" ] },
    {
      "kind": "group",
      "path": "SafariExtension",
      "children": [
        { "path": "SafariWebExtensionHandler.swift", "target-membership": [ "SwiftpolisSafari/compile-sources" ] },
        { "path": "Info.plist" },
        { "path": "SafariExtension.entitlements" },
        {
          "kind": "group",
          "path": "Resources",
          "children": [
            { "path": "manifest.json", "target-membership": [ "SwiftpolisSafari/resources" ] },
            { "path": "background.js", "target-membership": [ "SwiftpolisSafari/resources" ] },
            { "path": "contentScripts", "target-membership": [ "SwiftpolisSafari/resources" ] },
            { "path": "icons", "target-membership": [ "SwiftpolisSafari/resources" ] },
            { "path": "popup", "target-membership": [ "SwiftpolisSafari/resources" ] },
            { "path": "scripts", "target-membership": [ "SwiftpolisSafari/resources" ] },
          ],
        },
      ],
    },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Swiftpolis.app", "id": "2E17325C309941ED00B995DB", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SwiftpolisSafari.appex", "id": "2E17325C309941ED00B995DC", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Swiftpolis/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/swiftpolis-native-host", "id": "2E17325C309941ED00B995DD", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ { "build-phase": "Swiftpolis/copy/Embed Native Host" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Swiftpolis",
      "id": "2E17325B309941ED00B995DB",
      "product": "Products/Swiftpolis.app",
      "product-type": "application",
      "dependencies": [
        "SwiftpolisSafari",
        "swiftpolis-native-host",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
        {
          "kind": "copy",
          "name": "Embed Native Host",
          "bundle-base-path": "executables-directory",
        },
        {
          "kind": "script",
          "name": "Embed Helpers",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": "tools/embed-helpers.sh\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "SwiftpolisDomain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SwiftpolisPersistence",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SwiftpolisEngines",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SwiftpolisServices",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SwiftpolisBridge",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Swiftpolis.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "Y4JD236954",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Swiftpolis-Info.plist",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Swiftpolis asks System Events to shut down your Mac when a queue or download you chose finishes.",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.amirabravesh.Swiftpolis",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    },
    {
      "name": "SwiftpolisSafari",
      "id": "2E17325B309941ED00B995DC",
      "product": "id:2E17325C309941ED00B995DC",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "SwiftpolisBridge",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "SafariExtension/SafariExtension.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "Y4JD236954",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "SafariExtension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Swiftpolis",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.amirabravesh.Swiftpolis.Extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    },
    {
      "name": "swiftpolis-native-host",
      "id": "2E17325B309941ED00B995DD",
      "product": "id:2E17325C309941ED00B995DD",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "SwiftpolisBridge",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "NativeHost/NativeHost.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "Y4JD236954",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.amirabravesh.Swiftpolis.NativeHost",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "Y4JD236954",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
